    exact_duplicates = int(df.duplicated().sum())

    validation_results.append({
        "Table": table_name,
        "Check": "No exact duplicate rows",
        "Result": exact_duplicates,
        "Status": "PASS" if exact_duplicates == 0 else "REVIEW"
    })

    # Check text columns for leading/trailing spaces.
    text_columns = df.select_dtypes(
        include=["object", "string"]
    ).columns

    whitespace_issues = 0

    for column in text_columns:
        nonmissing = df[column].dropna().astype(str)

        whitespace_issues += int(
            nonmissing.map(
                lambda value: (
                    value != value.strip()
                    or re.search(r"\s{2,}", value) is not None
                )
            ).sum()
        )

    validation_results.append({
        "Table": table_name,
        "Check": "Text whitespace issues",
        "Result": whitespace_issues,
        "Status": "PASS" if whitespace_issues == 0 else "REVIEW"
    })

    # Check missing values: report, do not automatically fill.
    missing_cells = int(df.isna().sum().sum())

    validation_results.append({
        "Table": table_name,
        "Check": "Missing cells",
        "Result": missing_cells,
        "Status": "REVIEW" if missing_cells > 0 else "PASS"
    })

    print(
        f"{table_name:24s} "
        f"Rows={len(df):6d} "
        f"Columns={len(df.columns):3d} "
        f"Missing cells={missing_cells:6d} "
        f"Exact duplicates={exact_duplicates}"
    )


