def record_referential_issues(
    child_df,
    child_table,
    child_column,
    valid_ids,
    parent_table,
    allow_values=None
):
    """
    Find child IDs that do not match a parent ID.
    Retain the original records and export the issues.
    """

    if child_column not in child_df.columns:
        return

    if allow_values is None:
        allow_values = set()

    values = child_df[child_column].astype("string").str.strip()

    invalid_mask = (
        values.notna()
        & values.ne("")
        & ~values.isin(valid_ids)
        & ~values.isin(allow_values)
    )

    missing_mask = (
        values.isna()
        | values.eq("")
    )

    invalid_count = int(invalid_mask.sum())
    missing_count = int(missing_mask.sum())

    if missing_count:
        referential_issues.append({
            "Child Table": child_table,
            "Child Column": child_column,
            "Parent Table": parent_table,
            "Issue Type": "Missing key",
            "Rows Affected": missing_count,
            "Action": "Retained; investigate source"
        })

    if invalid_count:
        referential_issues.append({
            "Child Table": child_table,
            "Child Column": child_column,
            "Parent Table": parent_table,
            "Issue Type": "Unmatched key",
            "Rows Affected": invalid_count,
            "Action": "Retained; investigate source"
        })

    if invalid_count or missing_count:
        detail = child_df.loc[
            invalid_mask | missing_mask
        ].copy()

        detail["ReferentialIssue"] = np.where(
            missing_mask.loc[detail.index],
            "Missing key",
            "Unmatched key"
        )

        safe_name = (
            f"referential_{child_table.lower().replace(' ', '_')}_"
            f"{child_column.lower()}.csv"
        )

        detail.to_csv(
            os.path.join(DUPLICATE_DIR, safe_name),
            index=False
        )

        print(
            f"{child_table}.{child_column}: "
            f"{missing_count} missing, "
            f"{invalid_count} unmatched"
        )


