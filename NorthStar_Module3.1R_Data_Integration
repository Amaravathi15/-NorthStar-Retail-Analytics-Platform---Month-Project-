def log_cleaning(
    table,
    column,
    issue,
    rows_affected,
    action,
    justification
):
    """Record every cleaning action or issue."""

    cleaning_log.append({
        "Table": table,
        "Column": column,
        "Issue": issue,
        "Rows Affected": int(rows_affected),
        "Action": action,
        "Justification": justification
    })


def standardise_text(df, table_name, column):
    """
    Trim leading/trailing spaces and collapse repeated spaces.
    Blank strings become missing values.
    """

    if column not in df.columns:
        return

    before = df[column].copy()

    def clean_value(value):
        if pd.isna(value):
            return np.nan

        value = re.sub(r"\s+", " ", str(value)).strip()

        if value == "":
            return np.nan

        return value

    df[column] = df[column].map(clean_value)

    changed = int(
        (
            before.fillna("__NULL__").astype(str)
            != df[column].fillna("__NULL__").astype(str)
        ).sum()
    )

    if changed:
        log_cleaning(
            table_name,
            column,
            "Whitespace or blank text inconsistency",
            changed,
            "Trimmed spaces, collapsed repeated spaces, "
            "converted blank strings to missing",
            "Consistent text improves grouping and joins."
        )


def standardise_id_case(df, table_name, column):
    """Standardise text IDs to uppercase without inventing IDs."""

    if column not in df.columns:
        return

    before = df[column].copy()

    df[column] = df[column].map(
        lambda value: value.upper()
        if isinstance(value, str)
        else value
    )

    changed = int(
        (
            before.fillna("__NULL__").astype(str)
            != df[column].fillna("__NULL__").astype(str)
        ).sum()
    )

    if changed:
        log_cleaning(
            table_name,
            column,
            "Inconsistent ID letter case",
            changed,
            "Converted text IDs to uppercase",
            "Consistent ID formatting supports reliable joins."
        )


def standardise_label(df, table_name, column, method="title"):
    """Standardise label casing while preserving missing values."""

    if column not in df.columns:
        return

    before = df[column].copy()

    if method == "title":
        df[column] = df[column].map(
            lambda value: value.title()
            if isinstance(value, str)
            else value
        )

    elif method == "lower":
        df[column] = df[column].map(
            lambda value: value.lower()
            if isinstance(value, str)
            else value
        )

    changed = int(
        (
            before.fillna("__NULL__").astype(str)
            != df[column].fillna("__NULL__").astype(str)
        ).sum()
    )

    if changed:
        log_cleaning(
            table_name,
            column,
            "Inconsistent label casing",
            changed,
            f"Standardised label casing using {method}",
            "Consistent category labels improve grouping and reporting."
        )


def parse_date_column(
    df,
    table_name,
    column,
    date_format=None
):
    """Convert date columns to datetime without guessing invalid dates."""

    if column not in df.columns:
        return

    before = df[column].copy()

    nonblank = (
        before.notna()
        & before.astype("string").str.strip().ne("")
    )

    parsed = pd.to_datetime(
        before,
        format=date_format,
        errors="coerce"
    )

    invalid_count = int(
        (nonblank & parsed.isna()).sum()
    )

    missing_count = int(
        (~nonblank).sum()
    )

    if invalid_count:
        log_cleaning(
            table_name,
            column,
            "Invalid date values",
            invalid_count,
            "Converted invalid dates to NaT and flagged them",
            "Dates must not be guessed because that could distort "
            "time-based analysis."
        )

    if missing_count:
        log_cleaning(
            table_name,
            column,
            "Missing date values",
            missing_count,
            "Retained missing dates as NaT",
            "No dates were invented."
        )

    df[column] = parsed


def convert_numeric_column(df, table_name, column):
    """Convert numeric columns and flag invalid values."""

    if column not in df.columns:
        return

    before = df[column].copy()

    nonblank = (
        before.notna()
        & before.astype("string").str.strip().ne("")
    )

    converted = pd.to_numeric(
        before,
        errors="coerce"
    )

    invalid_count = int(
        (nonblank & converted.isna()).sum()
    )

    if invalid_count:
        log_cleaning(
            table_name,
            column,
            "Non-numeric values in numeric column",
            invalid_count,
            "Converted invalid values to NaN",
            "Invalid numeric values require investigation; "
            "they should not be silently replaced with zero."
        )

    missing_count = int(converted.isna().sum())

    if missing_count:
        log_cleaning(
            table_name,
            column,
            "Missing or invalid numeric values",
            missing_count,
            "Retained as NaN",
            "Replacing missing amounts or quantities with zero "
            "could distort business calculations."
        )

    df[column] = converted


def flag_invalid_values(
    df,
    table_name,
    column,
    condition,
    issue,
    justification
):
    """Log invalid values without silently changing them."""

    if column not in df.columns:
        return

    mask = condition.fillna(False)
    count = int(mask.sum())

    if count:
        log_cleaning(
            table_name,
            column,
            issue,
            count,
            "Flagged for investigation; original values retained",
            justification
        )

        print(
            f"WARNING: {table_name}.{column}: "
            f"{count} value(s) flagged — {issue}"
        )


def remove_exact_duplicates(df, table_name):
    """
    Remove only completely identical rows.
    Conflicting business-key duplicates are not deleted.
    """

    duplicate_mask = df.duplicated(keep=False)
    duplicate_count = int(df.duplicated().sum())

    duplicate_report.append({
        "Table": table_name,
        "Rows Before": len(df),
        "Exact Duplicate Rows Removed": duplicate_count,
        "Rows After": len(df) - duplicate_count
    })

    if duplicate_mask.any():
        duplicate_file = (
            f"duplicate_full_rows_"
            f"{table_name.lower().replace(' ', '_')}.csv"
        )

        df.loc[duplicate_mask].to_csv(
            os.path.join(DUPLICATE_DIR, duplicate_file),
            index=False
        )

    if duplicate_count:
        df = df.drop_duplicates(keep="first").copy()

        log_cleaning(
            table_name,
            "__entire_row__",
            "Exact duplicate records",
            duplicate_count,
            "Removed exact duplicate rows, keeping the first copy",
            "All columns match exactly, so repeated copies "
            "add no new information."
        )

    return df


def check_repeated_key(
    df,
    table_name,
    key_column
):
    """
    Report repeated keys for investigation.
    Do not delete non-identical records automatically.
    """

    if key_column not in df.columns:
        return

    valid_ids = df[key_column].dropna()
    duplicate_mask = (
        df[key_column].notna()
        & df[key_column].duplicated(keep=False)
    )

    repeated_rows = int(duplicate_mask.sum())

    duplicate_report.append({
        "Table": table_name,
        "Key Checked": key_column,
        "Rows With Repeated Key": repeated_rows
    })

    if repeated_rows:
        filename = (
            f"repeated_key_{table_name.lower().replace(' ', '_')}_"
            f"{key_column.lower()}.csv"
        )

        df.loc[duplicate_mask].to_csv(
            os.path.join(DUPLICATE_DIR, filename),
            index=False
        )

        log_cleaning(
            table_name,
            key_column,
            "Repeated business key",
            repeated_rows,
            "Saved repeated-key records for investigation; "
            "retained records",
            "Non-identical records must not be deleted without "
            "a documented business rule."
        )

        print(
            f"WARNING: {table_name}.{key_column} has "
            f"{repeated_rows} rows with repeated keys. "
            f"Review the duplicates folder."
        )


